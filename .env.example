# ArVee local development environment template
# Copy to .env and set real values.
# Never commit .env to git.

# App runtime
ARVEE_HOST=0.0.0.0
ARVEE_PORT=7860
ARVEE_DEBUG=false
ARVEE_OPEN_BROWSER=true
ARVEE_REQUIRE_USER_ID=false

# Database
# Local SQLite fallback name (used when ARVEE_DB_URL is not set)
ARVEE_LOCAL_DB_NAME=receipt_validator_db
ARVEE_DB_ECHO=false

# Remote DB (optional for local testing; required in cloud deployments)
# Example:
# ARVEE_DB_URL=postgresql+psycopg://user:pass@host:5432/arvee
ARVEE_DB_URL=

# LLM/API keys
GEMINI_API_KEY=
